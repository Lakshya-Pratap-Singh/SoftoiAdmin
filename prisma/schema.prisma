// Softoi Admin — Prisma schema
// Central data model for products, inventory, orders, POS, and stalls/events.
// Design notes:
// - Nothing is hard-deleted (products/categories/stalls use `status`); stock
//   history is append-only and never deleted or edited.
// - Every inventory change must produce a StockMovement row — enforced in
//   application code inside a DB transaction, not at the schema level.
// - `reference_type` / `reference_id` on StockMovement loosely link back to
//   whatever triggered the movement (an Order, a manual adjustment, etc.)
//   without a hard FK, so new movement sources can be added later without
//   a schema migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  INVENTORY_MANAGER
  STAFF
  STALL_MANAGER
}

enum ProductType {
  FINISHED_PRODUCT
  RAW_MATERIAL
  COMPONENT
  VARIANT_PRODUCT // future-ready, not exposed in V1 UI
  COMBO_PRODUCT // future-ready, not exposed in V1 UI
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum StockMovementType {
  INITIAL_STOCK
  STOCK_IN
  STOCK_OUT
  STOCK_ADJUSTMENT
  POS_SALE
  ONLINE_ORDER
  ORDER_CANCELLATION
  STOCK_RESTORATION
  COMPONENT_CONSUMED // component stock used up producing a finished product via its Bill of Materials
}

enum StallStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SalesChannel {
  WEBSITE
  OFFLINE_STALL
  MALL
  EXHIBITION
  POPUP_STORE
  INSTAGRAM
  MANUAL_ORDER
  OTHER
}

enum OrderStatus {
  DRAFT
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  OTHER
}

enum FeedbackQRStatus {
  ACTIVE
  DISABLED
  EXPIRED // reserved — nothing sets this yet (no expiry rule defined)
}

// ---------------------------------------------------------------------------
// USERS
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stockMovements StockMovement[] @relation("StockMovementCreatedBy")
  orders         Order[]         @relation("OrderCreatedBy")
  feedbackQRs    ArtisanFeedbackQR[] @relation("FeedbackQRCreatedBy")

  @@map("users")
}

// ---------------------------------------------------------------------------
// CATEGORIES
// ---------------------------------------------------------------------------

model Category {
  id          String       @id @default(cuid())
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  products Product[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// ARTISANS
// ---------------------------------------------------------------------------

enum ArtisanType {
  FAMILY            // family members / close relatives
  RAW_MATERIAL_SUPPLIED // we supply the raw material
  INDEPENDENT       // sources and makes independently
}

model Artisan {
  id        String       @id @default(cuid())
  code      String       @unique // e.g. AB01 — initials + sequential 2-digit
  name      String
  type      ArtisanType
  phone     String?
  // Stored normalised as E.164 (e.g. +919876543210). Used for the
  // "Artisan Appreciation" WhatsApp link; if empty, `phone` is used instead.
  whatsappNumber String?
  notes     String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  products    Product[]
  feedbackQRs ArtisanFeedbackQR[]

  @@map("artisans")
}

// ---------------------------------------------------------------------------
// PRODUCTS
// ---------------------------------------------------------------------------

model Product {
  id             String       @id @default(cuid())
  productCode    String       @unique // e.g. SOF-0001, auto-generated
  name           String
  sku            String?      @unique
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id])
  artisanId      String?
  artisan        Artisan?     @relation(fields: [artisanId], references: [id])
  productType    ProductType  @default(FINISHED_PRODUCT)
  description    String?
  imageUrl       String?

  currentStock   Int          @default(0)
  minimumStock   Int          @default(0)

  costPrice      Decimal?     @db.Decimal(10, 2)
  sellingPrice   Decimal?     @db.Decimal(10, 2)

  notes          String?
  status         RecordStatus @default(ACTIVE)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stockMovements StockMovement[]
  orderItems     OrderItem[]

  // Bill of materials: when this product is a finished product, which
  // components it uses (bouquet -> flowers, wrap, ribbon, etc.)
  componentsUsed ProductComponent[] @relation("FinishedProductComponents")
  // The reverse: other finished products that use this product as a component
  usedInProducts ProductComponent[] @relation("ComponentUsedIn")

  feedbackQRs ArtisanFeedbackQR[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

// ---------------------------------------------------------------------------
// BILL OF MATERIALS — components used to make a finished product
// ---------------------------------------------------------------------------

model ProductComponent {
  id                 String   @id @default(cuid())
  finishedProductId  String
  finishedProduct    Product  @relation("FinishedProductComponents", fields: [finishedProductId], references: [id], onDelete: Cascade)
  componentProductId String
  componentProduct   Product  @relation("ComponentUsedIn", fields: [componentProductId], references: [id])
  // Quantity of the component consumed per 1 unit of the finished product —
  // decimal so fractional amounts work (e.g. 0.5 of a wrap sheet).
  quantity           Decimal  @db.Decimal(10, 3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([finishedProductId, componentProductId])
  @@map("product_components")
}

// ---------------------------------------------------------------------------
// STOCK MOVEMENTS — append-only ledger, never edited or deleted
// ---------------------------------------------------------------------------

model StockMovement {
  id               String            @id @default(cuid())
  productId        String
  product          Product           @relation(fields: [productId], references: [id])

  movementType     StockMovementType
  quantity         Int // signed: positive for additions, negative for removals
  previousQuantity Int
  newQuantity      Int

  reason           String
  notes            String?

  // Loose polymorphic reference to whatever caused this movement
  // (e.g. referenceType: "ORDER", referenceId: order.id).
  referenceType    String?
  referenceId      String?

  createdById      String?
  createdBy        User?             @relation("StockMovementCreatedBy", fields: [createdById], references: [id])

  movementDate     DateTime          @default(now())
  createdAt        DateTime          @default(now())

  @@index([productId])
  @@index([movementType])
  @@index([movementDate])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// CUSTOMERS
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@map("customers")
}

// ---------------------------------------------------------------------------
// STALLS & EVENTS
// ---------------------------------------------------------------------------

model Stall {
  id        String      @id @default(cuid())
  stallCode String      @unique // e.g. STL-0001
  name      String
  location  String?
  mallName  String?
  eventName String?
  startDate DateTime?
  endDate   DateTime?
  status    StallStatus @default(UPCOMING)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  orders Order[]

  @@map("stalls")
}

// ---------------------------------------------------------------------------
// ORDERS
// ---------------------------------------------------------------------------

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique // e.g. ORD-000001

  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])

  salesChannel  SalesChannel
  stallId       String?
  stall         Stall?        @relation(fields: [stallId], references: [id])

  status        OrderStatus   @default(DRAFT)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod?

  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)

  notes         String?

  createdById   String?
  createdBy     User?         @relation("OrderCreatedBy", fields: [createdById], references: [id])

  orderDate     DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items       OrderItem[]
  feedbackQRs ArtisanFeedbackQR[]

  @@index([salesChannel])
  @@index([status])
  @@index([stallId])
  @@index([orderDate])
  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId          String?
  product            Product? @relation(fields: [productId], references: [id])

  // Snapshots so historical orders stay accurate even if the product changes later
  productNameSnapshot String
  skuSnapshot         String?

  quantity           Int
  unitPrice           Decimal  @db.Decimal(10, 2)
  discount             Decimal  @default(0) @db.Decimal(10, 2)
  total                Decimal  @db.Decimal(10, 2)

  createdAt          DateTime @default(now())

  feedbackQRs        ArtisanFeedbackQR[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// ARTISAN APPRECIATION QR — one row per printed QR code
// ---------------------------------------------------------------------------
// The QR encodes only https://<APP_BASE_URL>/feedback/<token>. The token is a
// random, unguessable string; everything else (product, artisan, WhatsApp
// number) is resolved server-side, so mappings can be changed or the QR
// disabled without reprinting anything.
//
// orderId / orderItemId are optional so the same table can later hold QRs that
// are not tied to an order (campaign / event QRs).
// productId / artisanId are snapshotted at generation time: reassigning a
// product to another artisan later does not silently redirect QRs already
// printed and shipped.
//
// Counters are honest, not aspirational: scanCount = page opened,
// whatsappOpenCount = customer tapped the WhatsApp button. Whether the message
// was actually SENT cannot be known with a wa.me link, so it is not tracked.

model ArtisanFeedbackQR {
  id                 String           @id @default(cuid())
  token              String           @unique

  orderId            String?
  order              Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItemId        String?
  orderItem          OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  productId          String
  product            Product          @relation(fields: [productId], references: [id])
  artisanId          String
  artisan            Artisan          @relation(fields: [artisanId], references: [id])

  status             FeedbackQRStatus @default(ACTIVE)

  scanCount          Int              @default(0)
  firstScannedAt     DateTime?
  lastScannedAt      DateTime?
  whatsappOpenCount  Int              @default(0)
  lastWhatsappOpenAt DateTime?

  // Set on the NEW row when an admin regenerates a lost/damaged QR; the old
  // row is disabled so its token stops working.
  regeneratedFromId  String?
  regeneratedFrom    ArtisanFeedbackQR?  @relation("FeedbackQRRegeneration", fields: [regeneratedFromId], references: [id], onDelete: SetNull)
  regeneratedTo      ArtisanFeedbackQR[] @relation("FeedbackQRRegeneration")

  createdById        String?
  createdBy          User?            @relation("FeedbackQRCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  disabledAt         DateTime?

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([orderId])
  @@index([orderItemId, status])
  @@index([productId])
  @@index([artisanId])
  @@index([status])
  @@index([createdAt])
  @@map("artisan_feedback_qrs")
}

// ---------------------------------------------------------------------------
// SETTINGS — single-row table for business/inventory settings
// ---------------------------------------------------------------------------

model Settings {
  id                      String   @id @default(cuid())
  businessName            String   @default("Softoi")
  businessLogoUrl         String?
  currency                String   @default("INR")
  defaultMinimumStock     Int      @default(0)
  allowNegativeStock      Boolean  @default(false)
  updatedAt               DateTime @updatedAt

  @@map("settings")
}
